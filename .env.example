# Create this file with:  python main.py setup
# Or copy this example and edit, then:  python main.py start
# Update later with:  python main.py config --allowed-users @you --mode yolo

# Telegram Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF_your_telegram_bot_token

# Comma-separated Telegram user IDs and/or @usernames
# Example: 123456789,987654321,@alice,bob
ALLOWED_USERS=123456789,@your_username

# Workspace paths used as fallbacks. `telecursor start` overrides both with
# the current working directory for that run (so: cd project && telecursor start -d).
ALLOWED_WORKSPACE_PATH=/home/ubuntu/projects
DEFAULT_WORKSPACE_PATH=/home/ubuntu/projects

# Path to the cursor-agent / agent binary
AGENT_BIN=/home/ubuntu/.local/bin/agent

# Optional Cursor API key (blank = use `agent login` session on this machine)
CURSOR_API_KEY=

# Directory for temporary photo/document uploads (created if missing)
# Default: <app-home>/temp_uploads
TEMP_UPLOAD_DIR=

# Stream edit throttle for Telegram message updates (seconds)
STREAM_EDIT_INTERVAL=1.5

# Max prompts waiting in queue per chat (while one run is active)
MAX_QUEUE_SIZE=20

# Default execution mode: safe | yolo
DEFAULT_MODE=safe

# Default model (blank / auto = agent default)
AGENT_MODEL=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
